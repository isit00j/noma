<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Focus"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#3A3A3C" />

    <LinearLayout
        android:id="@+id/focus_note_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/focus_rail"
            android:layout_width="4dp"
            android:layout_height="40dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/widget_rail" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/focus_note_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="end"
                android:textSize="14sp"
                android:textColor="#1C1C1E" />

            <TextView
                android:id="@+id/focus_note_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textSize="12sp"
                android:textColor="#8E8E93" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/focus_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textSize="12sp"
        android:textColor="#8E8E93" />

    <!-- RemoteViews-compatible divider: plain <View> is NOT in Android's
         RemoteViews widget list and fails launcher-side inflation. -->
    <ImageView
        android:id="@+id/widget_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="#E5E5EA" />

    <LinearLayout
        android:id="@+id/focus_next_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/focus_next_check"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:padding="1dp"
            android:src="@drawable/widget_check_off"
            android:contentDescription="Mark done" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/focus_next_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="end"
                android:textSize="14sp"
                android:textColor="#1C1C1E" />

            <TextView
                android:id="@+id/focus_next_due"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#8E8E93" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Nothing on your plate"
        android:textSize="13sp"
        android:textColor="#8E8E93"
        android:visibility="gone" />

</LinearLayout>
