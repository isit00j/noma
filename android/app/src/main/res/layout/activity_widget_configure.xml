<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_configure_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1C1C1E" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/widget_configure_body"
        android:textSize="14sp"
        android:textColor="#6E6E73"
        android:gravity="center" />

    <Button
        android:id="@+id/configure_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/widget_configure_add" />

    <Button
        android:id="@+id/configure_customize"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/widget_configure_customize"
        style="?android:attr/borderlessButtonStyle" />

</LinearLayout>
