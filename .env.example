# Noma needs no environment variables.
#
# Firebase Web App configuration (public, client-side) lives in:
#   src/config/firebaseConfig.ts
#
# The optional Google Drive backup OAuth Web client ID lives in the same file
# (googleDriveClientId) and is separate from Firebase Google Sign-In.
#
# Never add Firebase Admin SDK credentials, service-account keys, or OAuth
# client secrets to this project.
