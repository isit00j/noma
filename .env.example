# Noma configuration — copy to .env and fill in your own values.
# Only public client values belong here. Never add Firebase Admin SDK
# credentials, service-account keys, or OAuth client secrets.

# Firebase Authentication (Firebase console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: Google Drive backup (Google Cloud console > Credentials >
# OAuth 2.0 Client ID of type "Web application").
# Scope used: https://www.googleapis.com/auth/drive.file
VITE_GOOGLE_CLIENT_ID=
